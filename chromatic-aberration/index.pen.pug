- var img = 'https://images.unsplash.com/photo-1581300134629-4c3a06a31948?ixlib=rb-1.2.1&ixid=MnwxMjA3fDB8MHxzZWFyY2h8MjN8fGFuaW1hbHxlbnwwfHwwfHw%3D&auto=format&fit=crop&w=900&q=60'

input#abberation-toggle(type="checkbox" checked)

.form 
	input#img-input(type="text" placeholder="Image URL")
	| or
	button#upload(type="button") Upload 📁
	input#file-input(type="file" accept="image/*" hidden)
	| or
	button#more-cats More 😻
.abberate(style=`--image: url(${img})`)
	img(src=img)
.form 
	label(for="abberation-toggle") 
		.toggle
	input#intensity(type="range"  min="0" max="100" value="50")
	select#colours
		option(value="red, blue") Red, Blue
		option(value="#00ff87, #5000ff") Green, Purple
		option(value="yellow, #f700ff") Yellow, Pink
	button#download(type="button") Download ⬇️
p#note
